# Content Sphere Hub environment configuration
# Copy to .env for local development. Configure production values in Railway/Vercel.

# Backend runtime
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME=Content Sphere Hub
APP_URL=http://localhost:5173
# Public origin of the backend, without a trailing slash. Required for production media URLs.
# PUBLIC_API_URL=https://your-backend.up.railway.app

# MongoDB
MONGODB_URI=mongodb://localhost:27017/content-sphere-hub
MONGODB_DB_NAME=content-sphere-hub

# Authentication (use independent secrets of at least 32 characters in production)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min32
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=content-sphere-hub
JWT_AUDIENCE=content-sphere-hub-api

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGINS=http://localhost:5173

# Uploads
UPLOAD_PROVIDER=local
UPLOAD_LOCAL_PATH=./uploads
UPLOAD_MAX_IMAGE_SIZE=10485760
UPLOAD_MAX_DOCUMENT_SIZE=26214400
UPLOAD_MAX_VIDEO_SIZE=104857600

# Optional Redis (the current server does not connect to Redis at startup)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Feature flags
FEATURE_ENABLE_REGISTRATION=true
FEATURE_ENABLE_COMMENTS=true
FEATURE_ENABLE_NEWSLETTER=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# Initial admin seed (only used when running pnpm seed or pnpm seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# Frontend build-time variable
VITE_API_URL=http://localhost:5000/api/v1
