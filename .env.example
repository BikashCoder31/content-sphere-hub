# Content Sphere Hub - Environment Configuration
# Copy this file to .env and update the values

# ======================
# Application Settings
# ======================
NODE_ENV=production

# ======================
# Server Configuration
# ======================
BACKEND_PORT=5000
FRONTEND_PORT=3000

# ======================
# MongoDB Configuration
# ======================
# Root credentials (for initial setup)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-secure-root-password

# Application database credentials
MONGO_USER=app
MONGO_PASSWORD=your-secure-app-password
MONGO_DB=content_sphere
MONGO_PORT=27017

# Full connection string (used by backend)
# For Docker: mongodb://app:password@mongodb:27017/content_sphere?authSource=content_sphere
# For local: mongodb://localhost:27017/content_sphere
MONGODB_URI=mongodb://app:your-secure-app-password@mongodb:27017/content_sphere?authSource=content_sphere

# ======================
# JWT Authentication
# ======================
# Generate these with: openssl rand -base64 64
ACCESS_TOKEN_SECRET=your-64-character-access-token-secret-here
REFRESH_TOKEN_SECRET=your-64-character-refresh-token-secret-here

# Token expiration
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ======================
# CORS Configuration
# ======================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# ======================
# File Upload Settings
# ======================
# Max file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,application/pdf

# ======================
# API Configuration
# ======================
# Frontend API URL (for Vite build)
VITE_API_URL=/api/v1

# ======================
# Optional: Email Configuration
# ======================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM=noreply@example.com

# ======================
# Optional: Cloud Storage
# ======================
# STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
