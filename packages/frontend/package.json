{
  "name": "@content-sphere-hub/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Content Sphere Hub Frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
